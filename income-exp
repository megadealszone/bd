<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>প্রিমিয়াম আয়-ব্যয় ট্র্যাকার</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.5/lib/index.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- HTML2Canvas & jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap');
        
        body { 
            font-family: 'Noto Sans Bengali', sans-serif; 
            background-color: #f8fafc; 
        }
        
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        .glassmorphism {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .menu-item.active {
            background: linear-gradient(90deg, rgba(255,255,255,0.2), rgba(255,255,255,0.05));
            border-left: 4px solid #60a5fa;
            font-weight: bold;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 100;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(6px);
        }
        .modal-content {
            background-color: #ffffff;
            margin: 10% auto;
            padding: 20px;
            width: 92%;
            max-width: 700px;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col md:flex-row h-screen overflow-hidden">

    <!-- Sidebar Backdrop Overlay -->
    <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-30 hidden transition-opacity"></div>

    <!-- Sidebar Menu -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-72 bg-gradient-to-b from-slate-900 via-indigo-950 to-blue-950 text-white flex flex-col transition-transform duration-300 transform -translate-x-full shadow-2xl">
        <div class="h-20 flex items-center justify-between border-b border-white/10 px-6">
            <div class="flex items-center">
                <div class="bg-blue-600/30 p-2.5 rounded-xl border border-blue-400/20 mr-3">
                    <i class="fas fa-chart-pie text-2xl text-blue-400"></i>
                </div>
                <h1 class="text-xl font-bold tracking-wide bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">হিসাব-নিকাশ</h1>
            </div>
            <button onclick="toggleSidebar()" class="text-slate-400 hover:text-white transition p-2">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        <nav class="flex-1 mt-6 space-y-2 px-4">
            <button onclick="switchMenu('dashboard'); toggleSidebar();" id="menu-dashboard" class="menu-item active w-full flex items-center p-3.5 rounded-xl hover:bg-white/10 transition duration-200">
                <i class="fas fa-home text-lg mr-3 text-center w-6 text-blue-400"></i>
                <span class="font-medium">ড্যাশবোর্ড</span>
            </button>
            <button onclick="switchMenu('data-entry'); toggleSidebar();" id="menu-data-entry" class="menu-item w-full flex items-center p-3.5 rounded-xl hover:bg-white/10 transition duration-200">
                <i class="fas fa-edit text-lg mr-3 text-center w-6 text-indigo-400"></i>
                <span class="font-medium">ডাটা এন্ট্রি</span>
            </button>
            <button onclick="switchMenu('report'); toggleSidebar();" id="menu-report" class="menu-item w-full flex items-center p-3.5 rounded-xl hover:bg-white/10 transition duration-200">
                <i class="fas fa-file-alt text-lg mr-3 text-center w-6 text-purple-400"></i>
                <span class="font-medium">রিপোর্ট</span>
            </button>
            <button onclick="openRecycleBin(); toggleSidebar();" class="w-full flex items-center p-3.5 rounded-xl hover:bg-red-500/10 transition duration-200 mt-8 text-red-300 hover:text-red-200 border border-red-500/20">
                <i class="fas fa-trash-restore text-lg mr-3 text-center w-6"></i>
                <span class="font-medium">রিসাইকেল বিন</span>
            </button>
        </nav>
        <div class="p-4 border-t border-white/10 text-center text-xs text-slate-400">
            Pro Financial Suite v4.7
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden bg-slate-100/60 relative w-full">
        
        <!-- Header Top Bar -->
        <header class="h-20 glassmorphism flex justify-between items-center px-4 md:px-8 shadow-sm z-10 border-b border-slate-200/85 shrink-0">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="bg-white p-2.5 rounded-2xl shadow-sm hover:bg-slate-50 text-slate-700 transition border border-slate-200 flex items-center justify-center w-11 h-11 shrink-0" title="মেনু ওপেন করুন">
                    <i class="fas fa-bars text-lg text-blue-600"></i>
                </button>
                <h2 id="page-title" class="text-lg md:text-2xl font-extrabold gradient-text truncate">ড্যাশবোর্ড ওভারভিউ</h2>
            </div>
            
            <div class="flex items-center gap-2 md:gap-3">
                <div id="dashboard-toggle-wrapper" class="relative">
                    <button onclick="toggleDashboardContent()" class="bg-white p-2.5 rounded-2xl shadow-sm hover:bg-slate-50 text-slate-700 transition border border-slate-200 flex items-center justify-center w-11 h-11 shrink-0" title="ড্যাশবোর্ড হাইড/আনহাইড করুন">
                        <i class="fas fa-sliders-h text-lg text-indigo-600"></i>
                    </button>
                </div>
                <button onclick="downloadPDF()" id="pdf-btn" class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-3.5 md:px-5 py-2.5 rounded-2xl shadow-lg shadow-blue-500/25 hover:shadow-xl hover:shadow-blue-500/40 transform hover:-translate-y-0.5 transition duration-300 text-xs md:text-sm font-semibold flex items-center shrink-0">
                    <i class="fas fa-download mr-1.5 md:mr-2"></i> রিপোর্ট ডাউনলোড
                </button>
            </div>
        </header>

        <!-- Scrollable Content -->
        <div class="flex-1 overflow-y-auto p-3 md:p-8" id="main-scroll-area">
            
            <!-- ================= VIEW: DASHBOARD ================= -->
            <div id="view-dashboard" class="space-y-6 md:space-y-8 animate-fade-in pb-10">
                
                <div id="dashboard-content-box" class="space-y-6 md:space-y-8 transition-all duration-300">
                    
                    <!-- Summary Cards Row -->
                    <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6">
                        <!-- Total Income Card -->
                        <div class="relative bg-gradient-to-br from-emerald-500 via-teal-600 to-emerald-700 p-3 sm:p-5 md:p-6 rounded-3xl shadow-xl shadow-emerald-900/20 text-white border border-emerald-400/30 overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
                            <div class="absolute -right-6 -bottom-6 opacity-10 text-7xl md:text-8xl"><i class="fas fa-arrow-down"></i></div>
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center relative z-10 gap-2">
                                <div>
                                    <p class="text-[10px] sm:text-xs md:text-sm font-bold uppercase tracking-wider text-emerald-100 mb-1">সর্বমোট আয়</p>
                                    <h3 class="text-sm sm:text-xl md:text-3xl lg:text-4xl font-black tracking-tight text-white drop-shadow-md">৳ <span id="dash-total-income">0</span></h3>
                                </div>
                                <div class="bg-white/20 backdrop-blur-md p-2 sm:p-3 md:p-4 rounded-2xl shadow-inner shrink-0 hidden sm:flex">
                                    <i class="fas fa-arrow-down text-base sm:text-xl md:text-2xl text-white"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Total Expense Card -->
                        <div class="relative bg-gradient-to-br from-rose-500 via-pink-600 to-red-700 p-3 sm:p-5 md:p-6 rounded-3xl shadow-xl shadow-rose-900/20 text-white border border-rose-400/30 overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
                            <div class="absolute -right-6 -bottom-6 opacity-10 text-7xl md:text-8xl"><i class="fas fa-arrow-up"></i></div>
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center relative z-10 gap-2">
                                <div>
                                    <p class="text-[10px] sm:text-xs md:text-sm font-bold uppercase tracking-wider text-rose-100 mb-1">সর্বমোট ব্যয়</p>
                                    <h3 class="text-sm sm:text-xl md:text-3xl lg:text-4xl font-black tracking-tight text-white drop-shadow-md">৳ <span id="dash-total-expense">0</span></h3>
                                </div>
                                <div class="bg-white/20 backdrop-blur-md p-2 sm:p-3 md:p-4 rounded-2xl shadow-inner shrink-0 hidden sm:flex">
                                    <i class="fas fa-arrow-up text-base sm:text-xl md:text-2xl text-white"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Total Balance Card -->
                        <div class="relative bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-800 p-3 sm:p-5 md:p-6 rounded-3xl shadow-xl shadow-indigo-900/20 text-white border border-indigo-400/30 overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
                            <div class="absolute -right-6 -bottom-6 opacity-10 text-7xl md:text-8xl"><i class="fas fa-wallet"></i></div>
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center relative z-10 gap-2">
                                <div>
                                    <p class="text-[10px] sm:text-xs md:text-sm font-bold uppercase tracking-wider text-indigo-100 mb-1">বর্তমান ব্যালেন্স (নিট)</p>
                                    <h3 class="text-sm sm:text-xl md:text-3xl lg:text-4xl font-black tracking-tight text-white drop-shadow-md">৳ <span id="dash-total-balance">0</span></h3>
                                </div>
                                <div class="bg-white/20 backdrop-blur-md p-2 sm:p-3 md:p-4 rounded-2xl shadow-inner shrink-0 hidden sm:flex">
                                    <i class="fas fa-wallet text-base sm:text-xl md:text-2xl text-white"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Charts Section -->
                    <div class="grid grid-cols-1 gap-6">
                        <div class="bg-white p-5 md:p-6 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 flex flex-col justify-center items-center h-72 md:h-80">
                            <h3 class="font-bold text-slate-700 mb-2 w-full text-left text-sm flex items-center"><i class="fas fa-chart-line text-emerald-500 mr-2"></i> বহুরেখা ধারা (মাল্টি-লাইন ট্রেন্ড)</h3>
                            <div class="relative w-full h-full flex justify-center"><canvas id="trendLineChart"></canvas></div>
                        </div>
                    </div>

                    <!-- ================= MORE MINI GRAPHS SECTION ================= -->
                    <div class="space-y-4 pt-2">
                        <h3 class="text-base md:text-lg font-bold text-slate-800 flex items-center">
                            <i class="fas fa-chart-area text-indigo-600 mr-2"></i> বিশেষ বিশ্লেষণাত্মক মিনি গ্রাফসমূহ (স্বতন্ত্র রঙসহ)
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <!-- 1. Income Expense Ratio Chart -->
                            <div class="bg-white p-5 rounded-3xl shadow-md border border-slate-100 flex flex-col items-center justify-between">
                                <h4 class="font-bold text-blue-600 text-sm mb-2 w-full text-left flex items-center"><i class="fas fa-chart-pie mr-2"></i> ১. আয় ও ব্যয়ের অনুপাত</h4>
                                <div class="relative w-full h-44 flex justify-center items-center">
                                    <canvas id="incomeExpenseChart"></canvas>
                                </div>
                            </div>

                            <!-- 2. Transaction Up-Down Chart -->
                            <div class="bg-white p-5 rounded-3xl shadow-md border border-slate-100 h-64 flex flex-col">
                                <h4 class="font-bold text-amber-600 text-sm mb-2 flex items-center"><i class="fas fa-exchange-alt mr-2"></i> ২. ট্রানজেকশন আপ-ডাউন গ্রাফ</h4>
                                <div class="relative w-full flex-1"><canvas id="txUpDownChart"></canvas></div>
                            </div>
                            
                            <!-- 3. Combined Income & Expense Chart -->
                            <div class="bg-white p-5 rounded-3xl shadow-md border border-slate-100 h-64 flex flex-col">
                                <h4 class="font-bold text-indigo-600 text-sm mb-2 flex items-center"><i class="fas fa-balance-scale mr-2"></i> ৩. যৌথ আয় ও ব্যয়ের গ্রাফ</h4>
                                <div class="relative w-full flex-1"><canvas id="incomeExpenseMiniChart"></canvas></div>
                            </div>

                            <!-- 4. Daily Chart -->
                            <div class="bg-white p-5 rounded-3xl shadow-md border border-slate-100 h-64 flex flex-col">
                                <h4 class="font-bold text-blue-600 text-sm mb-2 flex items-center"><i class="fas fa-calendar-day mr-2"></i> ৪. প্রতিদিনের হিসাব গ্রাফ</h4>
                                <div class="relative w-full flex-1"><canvas id="dailyChart"></canvas></div>
                            </div>

                            <!-- 5. Weekly Chart -->
                            <div class="bg-white p-5 rounded-3xl shadow-md border border-slate-100 h-64 flex flex-col">
                                <h4 class="font-bold text-indigo-600 text-sm mb-2 flex items-center"><i class="fas fa-calendar-week mr-2"></i> ৫. প্রতি সপ্তাহের হিসাব গ্রাফ</h4>
                                <div class="relative w-full flex-1"><canvas id="weeklyChart"></canvas></div>
                            </div>

                            <!-- 6. Monthly Chart -->
                            <div class="bg-white p-5 rounded-3xl shadow-md border border-slate-100 h-64 flex flex-col">
                                <h4 class="font-bold text-purple-600 text-sm mb-2 flex items-center"><i class="fas fa-calendar-alt mr-2"></i> ৬. প্রতি মাসের হিসাব গ্রাফ</h4>
                                <div class="relative w-full flex-1"><canvas id="monthlyChart"></canvas></div>
                            </div>
                        </div>
                    </div>

                    <!-- Description Box Below Graphs -->
                    <div class="bg-gradient-to-r from-blue-50 via-indigo-50 to-purple-50 p-5 md:p-6 rounded-3xl border border-indigo-100 shadow-sm space-y-2">
                        <h4 class="font-bold text-indigo-900 flex items-center text-sm md:text-base">
                            <i class="fas fa-info-circle text-indigo-600 mr-2"></i> গ্রাফ বিশ্লেষণ ও নির্দেশিকা বক্স
                        </h4>
                        <p class="text-xs md:text-sm text-slate-700 leading-relaxed">
                            উপরের গ্রাফগুলোতে আপনার আর্থিক লেনদেনের সামগ্রিক চিত্র ফুটিয়ে তোলা হয়েছে। যৌথ আয়-ব্যয় গ্রাফে একই সাথে আয়ের (সবুজ) ও ব্যয়ের (গোলাপী) তুলনা দেখানো হয়েছে। এছাড়া প্রতিটি মিনি গ্রাফের আলাদা রঙ ব্যবহার করে নির্দিষ্ট ক্যাটাগরির ওঠানামা নিখুঁতভাবে ফুটিয়ে তোলা হয়েছে।
                        </p>
                    </div>

                    <!-- Weekly & Monthly Summaries -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-gradient-to-br from-indigo-50/80 to-blue-50/80 p-5 md:p-6 rounded-3xl shadow-lg border border-indigo-100">
                            <h3 class="font-bold text-indigo-900 border-b border-indigo-200/60 pb-3 mb-4 flex items-center text-sm md:text-base"><i class="fas fa-calendar-week mr-2 text-indigo-600"></i>গত ৭ দিনের হিসাব</h3>
                            <div class="space-y-3 text-sm">
                                <div class="flex justify-between"><span class="text-slate-600 font-medium">সাপ্তাহিক আয়:</span> <span class="font-bold text-emerald-600">৳ <span id="dash-weekly-income">0</span></span></div>
                                <div class="flex justify-between"><span class="text-slate-600 font-medium">সাপ্তাহিক ব্যয়:</span> <span class="font-bold text-rose-500">৳ <span id="dash-weekly-expense">0</span></span></div>
                                <div class="flex justify-between pt-2 border-t border-indigo-200/60"><span class="font-bold text-slate-800">সাপ্তাহিক ব্যালেন্স:</span> <span class="font-bold text-indigo-700">৳ <span id="dash-weekly-balance">0</span></span></div>
                            </div>
                        </div>
                        <div class="bg-gradient-to-br from-purple-50/80 to-pink-50/80 p-5 md:p-6 rounded-3xl shadow-lg border border-purple-100">
                            <h3 class="font-bold text-purple-900 border-b border-purple-200/60 pb-3 mb-4 flex items-center text-sm md:text-base"><i class="fas fa-calendar-alt mr-2 text-purple-600"></i>চলতি মাসের হিসাব</h3>
                            <div class="space-y-3 text-sm">
                                <div class="flex justify-between"><span class="text-slate-600 font-medium">মাসিক আয়:</span> <span class="font-bold text-emerald-600">৳ <span id="dash-monthly-income">0</span></span></div>
                                <div class="flex justify-between"><span class="text-slate-600 font-medium">মাসিক ব্যয়:</span> <span class="font-bold text-rose-500">৳ <span id="dash-monthly-expense">0</span></span></div>
                                <div class="flex justify-between pt-2 border-t border-purple-200/60"><span class="font-bold text-slate-800">মাসিক ব্যালেন্স:</span> <span class="font-bold text-purple-700">৳ <span id="dash-monthly-balance">0</span></span></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================= VIEW: DATA ENTRY ================= -->
            <div id="view-data-entry" class="hidden space-y-8 animate-fade-in pb-10 max-w-xl mx-auto">
                <div class="bg-white p-6 md:p-8 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100">
                    <h2 class="text-xl md:text-2xl font-bold mb-6 text-slate-800 border-b pb-3 text-center"><i class="fas fa-plus-circle text-blue-500 mr-2"></i>নতুন লেনদেন এন্ট্রি</h2>
                    <form id="transaction-form" class="space-y-5">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">তারিখ (DD MM YYYY)</label>
                            <input type="date" id="date" required class="w-full border-slate-200 rounded-2xl shadow-sm px-4 py-3.5 border focus:ring-2 focus:ring-blue-500 bg-slate-50/50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">লেনদেনের ধরন</label>
                            <select id="type" class="w-full border-slate-200 rounded-2xl shadow-sm px-4 py-3.5 border focus:ring-2 focus:ring-blue-500 font-bold bg-slate-50/50">
                                <option value="income" class="text-emerald-600">আয় (Income)</option>
                                <option value="expense" class="text-rose-500">ব্যয় (Expense)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">পরিমাণ (৳)</label>
                            <input type="number" id="amount" required placeholder="0.00" class="w-full border-slate-200 rounded-2xl shadow-sm px-4 py-3.5 border focus:ring-2 focus:ring-blue-500 bg-slate-50/50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">উৎস / বিবরণ</label>
                            <input type="text" id="source" required placeholder="যেমন: ব্যবসা, বেতন, বাজার খরচ" class="w-full border-slate-200 rounded-2xl shadow-sm px-4 py-3.5 border focus:ring-2 focus:ring-blue-500 bg-slate-50/50">
                        </div>
                        <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold py-4 px-4 rounded-2xl shadow-lg shadow-blue-500/25 hover:shadow-xl transition duration-300">
                            ডাটা সেভ করুন
                        </button>
                    </form>
                </div>
            </div>

            <!-- ================= VIEW: REPORT ================= -->
            <div id="view-report" class="hidden space-y-8 animate-fade-in pb-10">
                <div class="bg-white p-4 md:p-6 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 max-w-5xl mx-auto space-y-6">
