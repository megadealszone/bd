    <!-- Application Logic -->
    <script>
        document.getElementById('date').valueAsDate = new Date();
        const today = new Date();
        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        document.getElementById('filter-start').valueAsDate = firstDayOfMonth;
        document.getElementById('filter-end').valueAsDate = today;

        let transactions = JSON.parse(localStorage.getItem('premium_tracker_data')) || [];
        let deletedTransactions = JSON.parse(localStorage.getItem('premium_tracker_deleted')) || [];
        
        let chartInstance = null;
        let lineChartInstance = null;

        let txUpDownInstance = null;
        let incomeExpenseMiniInstance = null;
        let dailyInstance = null;
        let weeklyInstance = null;
        let monthlyInstance = null;

        let isSidebarOpen = false;

        // Date formatting helper function for DD-MM-YYYY (দিন-মাস-বছর)
        function formatDate(dateStr) {
            if (!dateStr) return '';
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            return `${day}-${month}-${year}`;
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            isSidebarOpen = !isSidebarOpen;
            if (isSidebarOpen) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
            }
        }

        function toggleDashboardContent() {
            const contentBox = document.getElementById('dashboard-content-box');
            contentBox.style.display = contentBox.style.display === 'none' ? 'block' : 'none';
        }

        function switchMenu(viewName) {
            document.querySelectorAll('.menu-item').forEach(el => el.classList.remove('active'));
            document.getElementById('menu-' + viewName).classList.add('active');

            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-data-entry').classList.add('hidden');
            document.getElementById('view-report').classList.add('hidden');
            
            document.getElementById('view-' + viewName).classList.remove('hidden');

            const titleEl = document.getElementById('page-title');
            const pdfBtn = document.getElementById('pdf-btn');
            const dashToggle = document.getElementById('dashboard-toggle-wrapper');
            
            if(viewName === 'dashboard') {
                titleEl.innerText = "ড্যাশবোর্ড ওভারভিউ";
                pdfBtn.style.display = "flex";
                dashToggle.style.display = "block";
                updateDashboard();
            } else if(viewName === 'data-entry') {
                titleEl.innerText = "ডাটা এন্ট্রি প্যানেল";
                pdfBtn.style.display = "none";
                dashToggle.style.display = "none";
            } else if(viewName === 'report') {
                titleEl.innerText = "বিস্তারিত রিপোর্ট";
                pdfBtn.style.display = "flex";
                dashToggle.style.display = "none";
                filterReportTable();
            }
        }

        function updateDashboard() {
            const now = new Date();
            const currentMonth = now.getMonth();
            const currentYear = now.getFullYear();
            
            const sevenDaysAgo = new Date();
            sevenDaysAgo.setDate(now.getDate() - 7);
            sevenDaysAgo.setHours(0,0,0,0);

            let sum = {
                totalIncome: 0, totalExpense: 0,
                weeklyIncome: 0, weeklyExpense: 0,
                monthlyIncome: 0, monthlyExpense: 0
            };

            transactions.forEach(t => {
                const tDate = new Date(t.date);
                const amt = t.amount;
                const isInc = t.type === 'income';

                isInc ? sum.totalIncome += amt : sum.totalExpense += amt;
                
                if (tDate >= sevenDaysAgo && tDate <= now) {
                    isInc ? sum.weeklyIncome += amt : sum.weeklyExpense += amt;
                }
                
                if (tDate.getMonth() === currentMonth && tDate.getFullYear() === currentYear) {
                    isInc ? sum.monthlyIncome += amt : sum.monthlyExpense += amt;
                }
            });

            document.getElementById('dash-total-income').innerText = sum.totalIncome.toLocaleString('en-IN');
            document.getElementById('dash-total-expense').innerText = sum.totalExpense.toLocaleString('en-IN');
            document.getElementById('dash-total-balance').innerText = (sum.totalIncome - sum.totalExpense).toLocaleString('en-IN');

            document.getElementById('dash-weekly-income').innerText = sum.weeklyIncome.toLocaleString('en-IN');
            document.getElementById('dash-weekly-expense').innerText = sum.weeklyExpense.toLocaleString('en-IN');
            document.getElementById('dash-weekly-balance').innerText = (sum.weeklyIncome - sum.weeklyExpense).toLocaleString('en-IN');

            document.getElementById('dash-monthly-income').innerText = sum.monthlyIncome.toLocaleString('en-IN');
            document.getElementById('dash-monthly-expense').innerText = sum.monthlyExpense.toLocaleString('en-IN');
            document.getElementById('dash-monthly-balance').innerText = (sum.monthlyIncome - sum.monthlyExpense).toLocaleString('en-IN');

            renderCharts(sum);
            renderMiniCharts(sum);
        }

        function renderCharts(sum) {
            const ctx3 = document.getElementById('trendLineChart').getContext('2d');
            if(lineChartInstance) lineChartInstance.destroy();

            const sortedByDate = [...transactions].sort((a,b) => new Date(a.date) - new Date(b.date));
            const lineLabels = sortedByDate.map(t => formatDate(t.date));
            const lineIncomeData = sortedByDate.map(t => t.type === 'income' ? t.amount : 0);
            const lineExpenseData = sortedByDate.map(t => t.type === 'expense' ? t.amount : 0);
            const lineNetData = sortedByDate.map((t, i, arr) => {
                let subInc = arr.slice(0, i+1).reduce((acc, cur) => cur.type === 'income' ? acc + cur.amount : acc, 0);
                let subExp = arr.slice(0, i+1).reduce((acc, cur) => cur.type === 'expense' ? acc + cur.amount : acc, 0);
                return subInc - subExp;
            });
            const lineTargetData = lineIncomeData.map(val => Math.max(0, val - 100));

            lineChartInstance = new Chart(ctx3, {
                type: 'line',
                data: {
                    labels: lineLabels.length > 0 ? lineLabels : ['ডেটা নেই'],
                    datasets: [
                        { label: 'আয় রেখা', data: lineIncomeData.length ? lineIncomeData : [0], borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.05)', fill: true, tension: 0.35, borderWidth: 2.5 },
                        { label: 'ব্যয় রেখা', data: lineExpenseData.length ? lineExpenseData : [0], borderColor: '#f43f5e', fill: false, tension: 0.35, borderWidth: 2.5 },
                        { label: 'নিট ব্যালেন্স রেখা', data: lineNetData.length ? lineNetData : [0], borderColor: '#10b981', fill: false, tension: 0.35, borderWidth: 2.5 },
                        { label: 'টার্গেট রেখা', data: lineTargetData.length ? lineTargetData : [0], borderColor: '#8b5cf6', borderDash: [4, 4], fill: false, tension: 0.35, borderWidth: 2 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
        }

        function renderMiniCharts(sum) {
            const ctx1 = document.getElementById('incomeExpenseChart').getContext('2d');
            let dataArr1 = (sum.totalIncome === 0 && sum.totalExpense === 0) ? [1, 1] : [sum.totalIncome, sum.totalExpense];
            let colors1 = (sum.totalIncome === 0 && sum.totalExpense === 0) ? ['#e2e8f0', '#e2e8f0'] : ['#3b82f6', '#f43f5e'];

            if(chartInstance) chartInstance.destroy();
            chartInstance = new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['মোট আয়', 'মোট ব্যয়'],
                    datasets: [{ data: dataArr1, backgroundColor: colors1, borderWidth: 0, hoverOffset: 4 }]
                },
                options: { 
                    responsive: true, 
                    maintainAspectRatio: false, 
                    cutout: '65%', 
                    plugins: { 
                        legend: { 
                            position: 'bottom',
                            labels: { boxWidth: 10, font: { size: 10 } }
                        } 
                    } 
                }
            });

            const sorted = [...transactions].sort((a,b) => new Date(a.date) - new Date(b.date));
            const labels = sorted.map(t => formatDate(t.date));

            if(txUpDownInstance) txUpDownInstance.destroy();
            txUpDownInstance = new Chart(document.getElementById('txUpDownChart').getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels.length ? labels : ['তথ্য নেই'],
                    datasets: [{ label: 'আপ-ডাউন ধারা', data: sorted.map(t => t.type === 'income' ? t.amount : -t.amount), borderColor: '#f59e0b', backgroundColor: 'rgba(245, 158, 11, 0.1)', fill: true, tension: 0.3 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            if(incomeExpenseMiniInstance) incomeExpenseMiniInstance.destroy();
            incomeExpenseMiniInstance = new Chart(document.getElementById('incomeExpenseMiniChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['তথ্য নেই'],
                    datasets: [
                        { label: 'আয়', data: sorted.map(t => t.type === 'income' ? t.amount : 0), backgroundColor: '#10b981', borderRadius: 4 },
                        { label: 'ব্যয়', data: sorted.map(t => t.type === 'expense' ? t.amount : 0), backgroundColor: '#f43f5e', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });

            if(dailyInstance) dailyInstance.destroy();
            dailyInstance = new Chart(document.getElementById('dailyChart').getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels.length ? labels : ['তথ্য নেই'],
                    datasets: [{ label: 'দৈনিক পরিমাণ', data: sorted.map(t => t.amount), borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: true, tension: 0.3 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            if(weeklyInstance) weeklyInstance.destroy();
            weeklyInstance = new Chart(document.getElementById('weeklyChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ['সপ্তাহ ১', 'সপ্তাহ ২', 'সপ্তাহ ৩', 'সপ্তাহ ৪'],
                    datasets: [{ label: 'সাপ্তাহিক গড়', data: [1200, 2100, 1800, 2500], backgroundColor: '#6366f1', borderRadius: 6 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            if(monthlyInstance) monthlyInstance.destroy();
            monthlyInstance = new Chart(document.getElementById('monthlyChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ['জানু', 'ফেব্রু', 'মার্চ', 'এপ্রিল', 'মে', 'জুন'],
                    datasets: [{ label: 'মাসিক সারসংক্ষেপ', data: [5000, 7000, 6500, 8000, 9500, 11000], backgroundColor: '#8b5cf6', borderRadius: 6 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });
        }

        function filterReportTable() {
            const startVal = document.getElementById('filter-start').value;
            const endVal = document.getElementById('filter-end').value;
            const typeVal = document.getElementById('report-type-filter').value;
            
            if(!startVal || !endVal) {
                alert('দয়া করে সঠিক তারিখ নির্বাচন করুন।');
                return;
            }

            const startDate = new Date(startVal); startDate.setHours(0,0,0,0);
            const endDate = new Date(endVal); endDate.setHours(23,59,59,999);

            let fIncome = 0;
            let fExpense = 0;

            const filteredData = transactions.filter(t => {
                const tDate = new Date(t.date);
                const matchesDate = (tDate >= startDate && tDate <= endDate);
                const matchesType = (typeVal === 'all' || t.type === typeVal);
                
                if (matchesDate) {
                    if (t.type === 'income') fIncome += t.amount;
                    else fExpense += t.amount;
                }
                return matchesDate && matchesType;
            });

            document.getElementById('filtered-income').innerText = fIncome.toLocaleString('en-IN');
            document.getElementById('filtered-expense').innerText = fExpense.toLocaleString('en-IN');
            document.getElementById('filtered-balance').innerText = (fIncome - fExpense).toLocaleString('en-IN');

            renderTable(filteredData);
        }

        function renderTable(dataToRender = transactions) {
            const list = document.getElementById('record-list');
            const emptyState = document.getElementById('empty-state');
            list.innerHTML = '';
            
            if (dataToRender.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
            
            const sortedData = [...dataToRender].sort((a, b) => new Date(b.date) - new Date(a.date));

            sortedData.forEach((t) => {
                const origIndex = transactions.indexOf(t);
                const isInc = t.type === 'income';
                const badge = isInc ? '<span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 rounded-full text-xs font-bold">আয়</span>' : '<span class="bg-rose-50 text-rose-700 border border-rose-200 px-3 py-1 rounded-full text-xs font-bold">ব্যয়</span>';
                const color = isInc ? 'text-emerald-600' : 'text-rose-500';
                
                const row = document.createElement('tr');
                row.className = "border-b hover:bg-slate-50 transition";
                row.innerHTML = `
                    <td class="py-4 px-4 whitespace-nowrap text-sm font-medium text-slate-600">${formatDate(t.date)}</td>
                    <td class="py-4 px-4 text-sm font-semibold text-slate-800">${t.source}</td>
                    <td class="py-4 px-4">${badge}</td>
                    <td class="py-4 px-4 text-right font-bold whitespace-nowrap ${color}">৳ ${t.amount.toLocaleString('en-IN')}</td>
                    <td class="py-4 px-4 text-center">
                        <button onclick="moveToRecycleBin(${origIndex})" class="text-slate-400 hover:text-rose-500 transition p-2" title="মুছে ফেলুন"><i class="fas fa-trash-alt text-base"></i></button>
                    </td>
                `;
                list.appendChild(row);
            });
        }

        document.getElementById('transaction-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const type = document.getElementById('type').value;
            const date = document.getElementById('date').value;
            const amount = parseFloat(document.getElementById('amount').value);
            const source = document.getElementById('source').value;

            if (date && amount && source) {
                transactions.push({ type, date, amount, source });
                saveData();
                
                document.getElementById('amount').value = '';
                document.getElementById('source').value = '';
                
                const btn = e.target.querySelector('button');
                const origText = btn.innerText;
                btn.innerText = "✓ সফলভাবে সেভ হয়েছে!";
                btn.classList.add("bg-emerald-600");
                setTimeout(() => { btn.innerText = origText; btn.classList.remove("bg-emerald-600"); }, 1500);
            }
        });

        function moveToRecycleBin(index) {
            deletedTransactions.push(transactions[index]);
            transactions.splice(index, 1);
            saveData();
            if(!document.getElementById('view-report').classList.contains('hidden')) {
                filterReportTable();
            }
        }

        function renderRecycleBin() {
            const list = document.getElementById('recycle-list');
            const emptyState = document.getElementById('empty-recycle-state');
            list.innerHTML = '';

            if (deletedTransactions.length === 0) {
                emptyState.style.display = 'block';
            } else {
                emptyState.style.display = 'none';
                deletedTransactions.forEach((t, index) => {
                    const isInc = t.type === 'income';
                    const badge = isInc ? '<span class="text-emerald-600 text-xs font-bold border border-emerald-200 px-2.5 py-0.5 rounded-full bg-emerald-50">আয়</span>' : '<span class="text-rose-500 text-xs font-bold border border-rose-200 px-2.5 py-0.5 rounded-full bg-rose-50">ব্যয়</span>';
                    const row = document.createElement('tr');
                    row.className = "border-b text-sm hover:bg-slate-50";
                    row.innerHTML = `
                        <td class="py-3 px-4 whitespace-nowrap text-slate-600">${formatDate(t.date)}</td>
                        <td class="py-3 px-4 font-medium text-slate-800">${t.source}</td>
                        <td class="py-3 px-4">${badge}</td>
                        <td class="py-3 px-4 text-right font-bold text-slate-700">৳ ${t.amount.toLocaleString('en-IN')}</td>
                        <td class="py-3 px-4 text-center whitespace-nowrap">
                            <button onclick="restoreRecord(${index})" class="text-blue-600 hover:bg-blue-50 p-2 rounded-xl transition mr-1" title="পুনরুদ্ধার"><i class="fas fa-undo"></i></button>
                            <button onclick="permanentDelete(${index})" class="text-rose-500 hover:bg-rose-50 p-2 rounded-xl transition" title="স্থায়ী ডিলিট"><i class="fas fa-times-circle"></i></button>
                        </td>
                    `;
                    list.appendChild(row);
                });
            }
        }

        function restoreRecord(index) {
            transactions.push(deletedTransactions[index]);
            deletedTransactions.splice(index, 1);
            saveData();
            renderRecycleBin();
            if(!document.getElementById('view-report').classList.contains('hidden')) {
                filterReportTable();
            }
        }

        function permanentDelete(index) {
            if(confirm('স্থায়ীভাবে মুছে যাবে। আপনি কি নিশ্চিত?')) {
                deletedTransactions.splice(index, 1);
                saveData();
                renderRecycleBin();
            }
        }

        function emptyRecycleBin() {
            if(deletedTransactions.length > 0 && confirm('রিসাইকেল বিনের সব ডাটা মুছে যাবে। আপনি কি নিশ্চিত?')) {
                deletedTransactions = [];
                saveData();
                renderRecycleBin();
            }
        }

        function saveData() {
            localStorage.setItem('premium_tracker_data', JSON.stringify(transactions));
            localStorage.setItem('premium_tracker_deleted', JSON.stringify(deletedTransactions));
        }

        function openRecycleBin() {
            renderRecycleBin();
            document.getElementById('recycleBinModal').style.display = 'block';
        }
        function closeRecycleBin() {
            document.getElementById('recycleBinModal').style.display = 'none';
        }
        window.onclick = function(e) {
            const modal = document.getElementById('recycleBinModal');
            if (e.target == modal) modal.style.display = "none";
        }

        window.downloadPDF = function() {
            const activeViewId = !document.getElementById('view-dashboard').classList.contains('hidden') ? 'view-dashboard' : 'view-report';
            const element = document.getElementById(activeViewId);
            
            const origBg = element.style.backgroundColor;
            element.style.backgroundColor = "#f8fafc";
            element.style.padding = "20px";

            html2canvas(element, { scale: 2, useCORS: true }).then(canvas => {
                const imgData = canvas.toDataURL('image/jpeg', 1.0);
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (canvas.height * pdfWidth) / canvas.width;
                
                pdf.text("Financial Report Summary", 15, 15);
                pdf.addImage(imgData, 'JPEG', 0, 20, pdfWidth, pdfHeight);
                pdf.save('Income_Expense_Report.pdf');

                element.style.backgroundColor = origBg;
                element.style.padding = "";
            });
        }

        switchMenu('dashboard');
    </script>
</body>
</html>
