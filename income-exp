                        <tr class="bg-slate-50 text-slate-600 text-xs uppercase">
                            <th class="py-3 px-4 font-bold border-b">তারিখ (দিন-মাস-বছর)</th>
                            <th class="py-3 px-4 font-bold border-b">বিবরণ</th>
                            <th class="py-3 px-4 font-bold border-b">ধরন</th>
                            <th class="py-3 px-4 font-bold border-b text-right">পরিমাণ</th>
